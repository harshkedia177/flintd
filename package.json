{
  "name": "flintd-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A library of tools that agents write for themselves.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p evals/tsconfig.json",
    "test": "pnpm -r test",
    "example": "node --disable-warning=ExperimentalWarning examples/offline.ts && node --disable-warning=ExperimentalWarning examples/sdk-offline.ts",
    "eval": "node --disable-warning=ExperimentalWarning evals/run.ts",
    "eval:check": "node --disable-warning=ExperimentalWarning --test evals/test/runner.test.ts",
    "eval:typecheck": "tsc --noEmit -p evals/tsconfig.json"
  },
  "dependencies": {
    "@flintd/core": "workspace:*",
    "@flintd/sdk": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.66",
    "@anthropic-ai/sdk": "0.125.0",
    "@google/genai": "2.22.0",
    "@types/node": "26.5.1",
    "ai": "7.0.99",
    "openai": "7.15.0",
    "typescript": "7.0.2"
  }
}
